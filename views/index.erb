<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="A Rack starter application running on Wodby.">
    <title>Ruby on Wodby</title>
    <link rel="stylesheet" href="/assets/styles.css">
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="page-title">
        <p class="status"><span aria-hidden="true"></span> Deployment healthy</p>
        <p class="kicker">Ruby + Rack + Wodby</p>
        <h1 id="page-title">Your Ruby app is running.</h1>
        <p class="intro">
          A compact Rack stack with real middleware, ERB rendering, static
          assets, request tests, and Puma production serving.
        </p>
        <div class="actions">
          <a class="primary" href="https://rack.github.io/">Build with Rack</a>
          <a href="https://wodby.com/docs/2.0/">Explore Wodby</a>
        </div>
      </section>

      <section class="details" aria-labelledby="details-title">
        <div>
          <p class="number">01</p>
          <h2 id="details-title">Runtime</h2>
        </div>
        <dl>
          <div>
            <dt>Ruby</dt>
            <dd><%= ruby_version %></dd>
          </div>
          <div>
            <dt>Rack</dt>
            <dd><%= rack_version %></dd>
          </div>
          <div>
            <dt>API example</dt>
            <dd><a href="/api/status">/api/status</a></dd>
          </div>
        </dl>
      </section>
    </main>

    <footer>
      <span>Rack starter ready</span>
      <a href="/healthz">Health check</a>
    </footer>
  </body>
</html>
